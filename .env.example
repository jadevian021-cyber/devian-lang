# Copy this file to .env and fill in the values. .env is gitignored.

# Clerk — Dashboard > API keys > Publishable key (starts with pk_test_ or pk_live_).
# Safe to ship in the app bundle. Never put a Clerk Secret Key in this file.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: native Google sign-in (development build only).
# Leave these blank and Google falls back to the browser OAuth flow.
# Client IDs come from Google Cloud > Credentials.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
# The iOS client ID reversed, e.g. com.googleusercontent.apps.123456-abcdef
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
